# IMAP credentials (cPanel)
EMAIL_ADDRESS=your_email@aqeeqkw.com
EMAIL_PASSWORD=your_cpanel_password

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Dashboard auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_32_char_string

# Database (use /data/agent.db on Railway with a volume mounted at /data)
DATABASE_PATH=data/agent.db

# ChromaDB (use /data/chroma_db on Railway)
CHROMA_PATH=data/chroma_db
